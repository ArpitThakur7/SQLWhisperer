# ============================================================
# SQLWhisperer — Environment Configuration Template
# Copy this file to .env and configure your keys as needed.
# ============================================================

# ─── LLM Provider Selection ─────────────────────────────────
# Supported providers: "groq" (recommended free), "openai", "gemini", "ollama", "openrouter"
LLM_PROVIDER=groq

# ─── Free Cloud Providers ───────────────────────────────────
# Groq (High-Speed Inference) — Get key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — Get key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── Local Offline Models (Ollama) ──────────────────────────
# 100% Free & Private — Install Ollama from https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ─── Commercial Providers (OpenAI) ──────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0

# ─── Target Database ────────────────────────────────────────
# Default: Embedded SQLite demo database (zero setup required)
DATABASE_URL=sqlite:///./data/demo_ecommerce.db

# Example PostgreSQL connection string:
# DATABASE_URL=postgresql://sqlwhisperer:localdev123@localhost:5432/sqlwhisperer

# ─── Query History & Memory (SQLite & Chroma) ───────────────
HISTORY_DB_URL=sqlite:///./data/query_history.db
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=few_shot_examples

# ─── Pipeline & Security Settings ───────────────────────────
MAX_REFINEMENT_RETRIES=3
MAX_RESULT_ROWS=100
QUERY_TIMEOUT_SECONDS=30
ALLOWED_SQL_COMMANDS=SELECT
BLOCKED_TABLES=

# ─── Observability (Optional) ───────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=sqlwhisperer
